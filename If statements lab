Meal time:
def main():
    time = input("What time is it? ")
    time = convert(time)
    if (time > 7.0) & (time < 8.0):
        return "breakfast time"
    elif (time > 12.0) & (time < 13.0):
        return "lunch time"
    elif (time > 18.0) & (time < 19.0):
        return "dinner time"
def convert(time):
    h,m = time.split(":")
    h = int(h)
    m = int(m)
    #1.6667 is 100 divided by 60
    m = m * 1.6667
    m = float(m/100)
    h = float(h + m)
    return h
print(main())

