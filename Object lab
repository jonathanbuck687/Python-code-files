class Song:
    def __init__(self, title: str, artist: str, duration: int):
        self.title = title
        self.artist = artist
        self.duration = duration

class Playlist:
    def __init__(self, name: str, songList: List[Song]):
        self.name = name
        self.songList = songList
    def add_song(self, song: Song):
        self.songList.append(song)
    def get_total_duration(self):
        total = 0
        for i in self.songList:
            total += i.duration
        print(total)
    def find_by_artist(self, artist: str):
        yesList = []
        for i in self.songList:
            if i.artist == artist:
                yesList.append(i)
        print("SONGS BY ", artist.upper(), "\n-----------------------")
        for i in yesList:
            print(i.title, ",", i.artist)
    def print_playlist(self):
        print(self.name.upper(), "\n-----------------------")
        for i in self.songList:
            print(i.title, ",", i.artist)
    def load_songs(self, filename: str):
        path = Path(filename)
        if not path.exists():
            path = Path(__file__).parent / filename

        with path.open("r") as file:
            songlist = [line.strip().split(",") for line in file.readlines()]
            for i in songlist:
                self.songList.append(Song(i[0], i[1], int(i[2])))

def main():
    songList = []
    playlist = Playlist("My Playlist", songList)
    playlist.load_songs("songs.csv")
    playlist.add_song(Song("My Fav Song", "Megabytes", 250))
    playlist.print_playlist()
    playlist.get_total_duration()
    playlist.find_by_artist("Null Pointer")


if __name__ == '__main__':
        main()

