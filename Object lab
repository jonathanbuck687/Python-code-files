from typing import List
class MenuItem:
    def __init__(self, name, price):
        self.name = name
        self.price = price

class Order:
    def __init__(self, receipt: List[MenuItem]):
        self.receipt = receipt
    def add_item(self, item):
        self.receipt.append(item)
    def calculate_taxes(self):
        sum = 0
        for i in self.receipt:
            sum = sum + (i.price * .07)
        return sum
    def calculate_total(self):
            sum = 0
            for i in self.receipt:
                sum = sum + (i.price * 1.07)
            return sum
    def print_receipt(self):
        print("CROSSROAD'S_CAFE\n----------------")
        for i in self.receipt:
            print(i.name.strip(" "), ": ", i.price)
        print("----------------\ntaxes: ", self.calculate_taxes(), "\n----------------\nTotal: ", self.calculate_total())

def main():
   
   menu = [
       MenuItem("bagel", 3.00),
       MenuItem("burrito", 5.00),
       MenuItem("ramen", 1.50),
       MenuItem("gum", 0.50)
   ]
     
   order1 = Order([])
   order1.add_item(menu[1])
   order1.add_item(menu[1])
   order1.add_item(menu[3])

   total = order1.calculate_total()
   print("The total due is " + str(total))

   order1.print_receipt()
   

if __name__ == '__main__':
        main()

