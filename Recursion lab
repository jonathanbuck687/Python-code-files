import unittest
def open_doll(doll):
    if (doll["inner_doll"] == "None"):
        return doll["size"]
    return open_doll(doll["inner_doll"])

class TestStringMethods(unittest.TestCase):
    def testAdd(self):
        self.assertEqual(open_doll({
        "size": 5, 
        "inner_doll": "None"}), 5)
        self.assertEqual(open_doll({
        "size": 12, 
        "inner_doll": {
            "size": 7, 
            "inner_doll": "None"
        }}), 7)
        self.assertEqual(open_doll({
        "size": 20, 
        "inner_doll": {
            "size": 15, 
            "inner_doll": {
                "size": 10, 
                "inner_doll": {
                    "size": 3, 
                    "inner_doll": "None"
                }
            }
        }}), 3)

if __name__ == '__main__':
    unittest.main()

