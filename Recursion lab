def draw_pattern(num):
    if (num == 1):
        print("*")
        return("")
    stri = ""
    for i in range(num):
        stri += "*"
    print(stri)
    draw_pattern(num - 1)
    stri = ""
    for i in range(num):
        stri += "*"
    print(stri)



def main():
    draw_pattern(3)

if __name__ == '__main__':
    main()


