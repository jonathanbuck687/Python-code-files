def is_palindrome(text):
    text = text.lower()
    j = 0
    newerText = ""
    while j < len(text):
        if (not(text[j: j + 1] == "." or text[j : j + 1] == "," or text[j: j + 1] == "?" or text[j: j + 1] == "!" or  text[j: j + 1] == ":" or  text[j: j + 1] == " ")):
            newerText = (newerText + text[j: j + 1])
        j += 1
    text = newerText
    if (len(text) == 1 or len(text) == 0):
         return True
    elif not(text[0:1] == text[len(text) - 1:]):
        return False
    return is_palindrome(text[1:len(text) - 1])

def main():
    pali = input("Enter a word: ")
    print(is_palindrome(pali))

if __name__ == '__main__':
    main()
