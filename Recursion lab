Collatz conjecture
-------------------
def collatz(num, count):
    print(num)
    if num == 1:
        return count
    elif num % 2 == 0:
        return collatz(num / 2, count + 1)
    elif num % 2 != 0:
        return collatz((num * 3) + 1, count + 1)

def main():
    num = input("What is the starting number? ")
    num = float(num)
    print("It runs ", collatz(num, 0)," times")

main()


