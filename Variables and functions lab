Tip calculator:
def main():
	cost = input("How much was the meal? ")
	percent = input("What percentage would you like to tip? ")
	cost = dollars_to_float(cost)
	percent = percent_to_float(percent)
	percent = percent / 100
	print("Leave $", cost * percent)
def dollars_to_float(d):
	d = d.replace("$", "")
	d = float(d)
	return d
def percent_to_float(p):
	p = p.replace("%", "")
	p = float(p)
	return p
main()


